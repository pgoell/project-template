# mise.toml: toolchain pins and task definitions

[tools]
{%- if stack == 'python' %}
python    = "{{ python_version }}"
uv        = "latest"
{%- elif stack == 'typescript' %}
bun       = "latest"
{%- elif stack == 'cpp' %}
cmake     = "latest"
ninja     = "latest"
# uv runs the pipx backend. clang-format and clang-tidy stay on one major
# version, so a new release does not reformat the code or add findings.
uv        = "latest"
"pipx:clang-format" = "23"
"pipx:clang-tidy"   = "23"
{%- endif %}
lefthook  = "latest"
cocogitto = "latest"
jq        = "latest"

# ─── Bootstrap ──────────────────────────────────────────────────────────────

[tasks.install]
description = "Install git hooks{% if stack != 'none' %} and dependencies{% endif %}"
run = [
  "lefthook install",
{%- if stack == 'python' %}
  "uv sync",
{%- elif stack == 'typescript' %}
  "bun install",
{%- elif stack == 'cpp' %}
  "cmake --preset dev",
{%- endif %}
]
{%- if stack == 'python' %}

# ─── Testing ────────────────────────────────────────────────────────────────

[tasks.test]
description = "Run tests"
run = "uv run pytest"

# ─── Lint & format ──────────────────────────────────────────────────────────

[tasks.lint]
description = "Lint, format-check and type-check"
run = [
  "uv run ruff check",
  "uv run ruff format --check",
  "uv run ty check",
]

[tasks.fmt]
description = "Auto-format"
run = "uv run ruff format"
{%- elif stack == 'typescript' %}

# ─── Testing ────────────────────────────────────────────────────────────────

# `--bun` runs the tools' node scripts on bun, so the project needs no node.
[tasks.test]
description = "Run tests"
run = "bun --bun run vitest run"

# ─── Lint & format ──────────────────────────────────────────────────────────

[tasks.lint]
description = "Lint, format-check and type-check"
run = [
  "bun --bun run biome check",
  "bun --bun run tsc --noEmit",
]

[tasks.fmt]
description = "Auto-format"
run = "bun --bun run biome format --write"
{%- elif stack == 'cpp' %}

# ─── Build & test ───────────────────────────────────────────────────────────

# The dev preset builds Debug with AddressSanitizer and UndefinedBehaviorSanitizer.
[tasks.build]
description = "Configure and build the dev preset"
run = [
  "cmake --preset dev",
  "cmake --build --preset dev",
]

[tasks.test]
description = "Run tests under the sanitizers"
depends = ["build"]
run = "ctest --preset dev"

# ─── Lint & format ──────────────────────────────────────────────────────────

# clang-tidy reads build/dev/compile_commands.json, which the configure writes.
[tasks.lint]
description = "Format-check and clang-tidy"
run = [
  "git ls-files -z -co --exclude-standard '*.cpp' '*.hpp' | xargs -0 -r clang-format --dry-run --Werror",
  "cmake --preset dev",
  "git ls-files -z -co --exclude-standard '*.cpp' | xargs -0 -r clang-tidy -p build/dev --quiet",
]

[tasks.fmt]
description = "Auto-format"
run = "git ls-files -z -co --exclude-standard '*.cpp' '*.hpp' | xargs -0 -r clang-format -i"
{%- endif %}

# ─── Commits ────────────────────────────────────────────────────────────────

[tasks.check-commits]
description = "Verify commits since origin/{{ default_branch }} are conventional"
# Before the first push there is no origin/{{ default_branch }}: check the whole history.
run = '''
if git rev-parse -q --verify origin/{{ default_branch }} >/dev/null; then
  cog check origin/{{ default_branch }}..HEAD
else
  cog check
fi
'''

# ─── GitHub repo config ─────────────────────────────────────────────────────

[tasks."repo:apply-settings"]
description = "Apply GitHub repo + branch-protection settings from .github/*.json, turn on Dependabot security updates"
run = "bash scripts/apply-github-settings.sh"

[tasks."repo:check-settings"]
description = "Diff live branch protection against .github/branch-protection.json, check security settings"
run = "bash scripts/apply-github-settings.sh --check"
