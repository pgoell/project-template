[tools]
{%- if stack == 'python' %}
python    = "{{ python_version }}"
uv        = "latest"
{%- elif stack == 'typescript' %}
bun       = "latest"
# Runs scripts/check-comments.
python    = "3.14"
{%- elif stack == 'cpp' %}
# Runs scripts/check-comments.
python    = "3.14"
cmake     = "latest"
ninja     = "latest"
# uv runs the pipx backend. clang-format and clang-tidy stay on one major
# version, so a new release does not reformat the code or add findings.
uv        = "latest"
"pipx:clang-format" = "23"
"pipx:clang-tidy"   = "23"
{%- elif stack == 'rust' %}
# Runs scripts/check-comments.
python    = "3.14"
# One minor version, so a new release does not add clippy findings.
rust      = { version = "1.100", components = "rustfmt,clippy" }
cargo-deny = "latest"
"aqua:nextest-rs/nextest/cargo-nextest" = "latest"
"ubi:bnjbvr/cargo-machete" = "latest"
{%- if frontend %}
bun       = "latest"
{%- endif %}
{%- endif %}
lefthook  = "latest"
cocogitto = "latest"
jq        = "latest"

[tasks.install]
description = "Install git hooks{% if stack != 'none' %} and dependencies{% endif %}"
run = [
  "lefthook install",
{%- if stack == 'python' %}
  "uv sync",
{%- elif stack == 'typescript' %}
  "bun install",
{%- elif stack == 'cpp' %}
  "cmake --preset dev",
{%- elif stack == 'rust' %}
  "cargo fetch",
{%- if frontend %}
  "cd frontend && bun install",
{%- endif %}
{%- endif %}
]
{%- if stack == 'python' %}

[tasks.test]
description = "Run tests"
run = "uv run pytest"

[tasks.lint]
description = "Lint, format-check and type-check"
run = [
  "uv run ruff check",
  "uv run ruff format --check",
  "uv run ty check",
]

[tasks.fmt]
description = "Auto-format"
run = "uv run ruff format"
{%- elif stack == 'typescript' %}

# `--bun` runs the tools' node scripts on bun, so the project needs no node.
[tasks.test]
description = "Run tests"
run = "bun --bun run vitest run"

[tasks.lint]
description = "Lint, format-check and type-check"
run = [
  "bun --bun run biome check",
  "bun --bun run tsc --noEmit",
]

[tasks.fmt]
description = "Auto-format"
run = "bun --bun run biome format --write"
{%- elif stack == 'cpp' %}

[tasks.build]
description = "Configure and build the dev preset"
run = [
  "cmake --preset dev",
  "cmake --build --preset dev",
]

[tasks.test]
description = "Run tests under the sanitizers"
depends = ["build"]
run = "ctest --preset dev"

[tasks.lint]
description = "Format-check and clang-tidy"
run = [
  "git ls-files -z -co --exclude-standard '*.cpp' '*.hpp' | xargs -0 -r clang-format --dry-run --Werror",
  "cmake --preset dev",
  "git ls-files -z -co --exclude-standard '*.cpp' | xargs -0 -r clang-tidy -p build/dev --quiet",
]

[tasks.fmt]
description = "Auto-format"
run = "git ls-files -z -co --exclude-standard '*.cpp' '*.hpp' | xargs -0 -r clang-format -i"
{%- elif stack == 'rust' %}

# nextest runs no doctests, so `cargo test --doc` does.
[tasks.test]
description = "Run tests"
run = [
  "cargo nextest run",
  "cargo test --doc",
{%- if frontend %}
  "cd frontend && bun --bun run vitest run",
{%- endif %}
]

[tasks.lint]
description = "Format-check, clippy, dependency checks{% if frontend %}, biome and tsc{% endif %}"
run = [
  "cargo fmt --check",
  "cargo clippy --all-targets -- -D warnings",
  "cargo deny check",
  "cargo machete",
{%- if frontend %}
  "cd frontend && bun --bun run biome check",
  "cd frontend && bun --bun run tsc --noEmit",
{%- endif %}
]

[tasks.fmt]
description = "Auto-format"
run = [
  "cargo fmt",
{%- if frontend %}
  "cd frontend && bun --bun run biome format --write",
{%- endif %}
]
{%- if frontend %}

[tasks."fe:dev"]
description = "Run the frontend dev server"
dir = "frontend"
run = "bun --bun run vite"

[tasks."fe:build"]
description = "Build the frontend into frontend/dist"
dir = "frontend"
run = "bun --bun run vite build"
{%- endif %}
{%- endif %}

[tasks.check-commits]
description = "Verify commits since origin/{{ default_branch }} are conventional"
run = '''
if git rev-parse -q --verify origin/{{ default_branch }} >/dev/null; then
  cog check origin/{{ default_branch }}..HEAD
else
  cog check
fi
'''

[tasks."repo:apply-settings"]
description = "Apply GitHub repo + branch-protection settings from .github/*.json, turn on Dependabot security updates"
run = "bash scripts/apply-github-settings.sh"

[tasks."repo:check-settings"]
description = "Diff live branch protection against .github/branch-protection.json, check security settings"
run = "bash scripts/apply-github-settings.sh --check"
