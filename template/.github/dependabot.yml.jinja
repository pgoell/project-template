version: 2
updates:
{%- set ecosystems = {'python': [['uv', '/']], 'typescript': [['bun', '/']], 'rust': [['cargo', '/']] + ([['bun', '/frontend']] if frontend else [])} %}
{%- for ecosystem, directory in ecosystems.get(stack, []) %}
  - package-ecosystem: {{ ecosystem }}
    directory: {{ directory }}
    schedule:
      interval: weekly
      day: monday
    open-pull-requests-limit: 5
    commit-message:
      prefix: build
    labels:
      - dependencies
{%- endfor %}
  - package-ecosystem: github-actions
    directory: /
    schedule:
      interval: weekly
      day: monday
    open-pull-requests-limit: 5
    commit-message:
      prefix: ci
    labels:
      - dependencies
