version: 2
updates:
{%- if stack != 'none' %}
  - package-ecosystem: {{ 'uv' if stack == 'python' else 'bun' }}
    directory: /
    schedule:
      interval: weekly
      day: monday
    open-pull-requests-limit: 5
    commit-message:
      prefix: build
    labels:
      - dependencies
{% endif %}
  - package-ecosystem: github-actions
    directory: /
    schedule:
      interval: weekly
      day: monday
    open-pull-requests-limit: 5
    commit-message:
      prefix: ci
    labels:
      - dependencies
