name: CI

on:
  pull_request:
    types: [opened, synchronize, reopened, ready_for_review]
  push:
    branches: [{{ default_branch }}]

{% raw -%}
concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true
{%- endraw %}

permissions:
  contents: read

jobs:
  lint:
    name: Lint
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6.1.0
{%- if stack != 'none' %}
        with:
          fetch-depth: 0
{%- endif %}
      - uses: ./.github/actions/setup-mise
{%- if stack == 'python' %}
      - name: Ruff and ty
        run: mise run lint
{%- elif stack == 'typescript' %}
      - name: Biome and tsc
        run: mise run lint
{%- elif stack == 'cpp' %}
      - name: clang-format and clang-tidy
        run: mise run lint
{%- elif stack == 'rust' %}
      - name: rustfmt, clippy, cargo-deny and cargo-machete{% if frontend %}, biome and tsc{% endif %}
        run: mise run lint
{%- endif %}
      - name: File size
        run: scripts/check-file-size
      - name: Fan-out
        run: scripts/check-fan-out --all
{%- if stack != 'none' %}
      - name: Comments
        run: scripts/check-comments "origin/${GITHUB_BASE_REF:-{{ default_branch }}}"
{%- endif %}
{%- if stack != 'none' %}

  test:
    name: Test
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6.1.0
      - uses: ./.github/actions/setup-mise
      - name: {{ {'python': 'Pytest', 'typescript': 'Vitest', 'cpp': 'CTest', 'rust': 'Nextest and vitest' if frontend else 'Nextest'}[stack] }}
        run: mise run test
{%- endif %}

  commits:
    name: Commits
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6.1.0
        with:
          fetch-depth: 0
      - uses: jdx/mise-action@c37c93293d6b742fc901e1406b8f764f6fb19dac # v2.4.4
      - name: Conventional commits
        run: mise run check-commits

  review:
{%- raw %}
    name: ${{ matrix.name }}
{%- endraw %}
    # The first step decides whether a round runs, not the job's `if:`. A matrix
    # job skipped by its `if:` never expands, so the required Review and Security
    # checks would wait forever.
    needs: [{{ 'lint' if stack == 'none' else 'lint, test' }}]
{%- raw %}
    if: ${{ !cancelled() && github.event_name == 'pull_request' }}
    runs-on: ubuntu-latest
    timeout-minutes: 30
    permissions:
      contents: read
      pull-requests: write
    strategy:
      fail-fast: false
      matrix:
        include:
          - kind: review
            name: Review
          - kind: security
            name: Security
    env:
      KIND: ${{ matrix.kind }}
      PR: ${{ github.event.pull_request.number }}
      HEAD_SHA: ${{ github.event.pull_request.head.sha }}
{%- endraw %}
      APPROVERS: {{ approvers }}
{%- raw %}
      GH_TOKEN: ${{ github.token }}
    steps:
      - id: decide
        env:
          RUN: >-
{%- endraw %}
            {% raw %}${{ needs.lint.result == 'success' &&{% endraw %}{% if stack != 'none' %} needs.test.result == 'success' &&{% endif %}
{%- raw %}
            github.event.pull_request.head.repo.full_name == github.repository &&
            github.event.pull_request.user.login != 'dependabot[bot]' &&
            !github.event.pull_request.draft }}
{%- endraw %}
        run: |
          echo "run=$RUN" >> "$GITHUB_OUTPUT"
          if [ "$RUN" != true ]; then echo "No round: a fork, Dependabot, a draft, or {{ 'Lint' if stack == 'none' else 'Lint or Test' }} did not pass." >> "$GITHUB_STEP_SUMMARY"; fi
{%- raw %}
      - if: steps.decide.outputs.run == 'true'
        uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6.1.0
        with:
          ref: ${{ github.event.pull_request.head.sha }}
          fetch-depth: 0
          persist-credentials: false
      - name: Install bubblewrap and socat and allow user namespaces, which Claude Code's sandbox needs
        if: steps.decide.outputs.run == 'true'
        run: |
          sudo apt-get install -y -qq bubblewrap socat
          sudo sysctl -w kernel.apparmor_restrict_unprivileged_userns=0
      - name: Read REVIEW.md and .github/review as the base branch has them
        if: steps.decide.outputs.run == 'true'
        run: |
          for path in REVIEW.md .github/review; do
            if git cat-file -e "origin/$GITHUB_BASE_REF:$path" 2>/dev/null; then
              git checkout -q "origin/$GITHUB_BASE_REF" -- "$path"
            fi
          done
      - name: Copy the review scripts out of the checkout, where the reviewer cannot write
        if: steps.decide.outputs.run == 'true'
        run: cp .github/review/round.sh .github/review/context.sh "$RUNNER_TEMP/"
      - id: base
        if: steps.decide.outputs.run == 'true'
        run: echo "sha=$(git merge-base "origin/$GITHUB_BASE_REF" HEAD)" >> "$GITHUB_OUTPUT"
      - id: round
        if: steps.decide.outputs.run == 'true'
        env:
          BASE_SHA: ${{ steps.base.outputs.sha }}
        run: bash "$RUNNER_TEMP/round.sh" plan
      - if: steps.round.outputs.stop == 'false'
        run: bash "$RUNNER_TEMP/context.sh"
      - id: prompt
        if: steps.round.outputs.stop == 'false'
        env:
          FROM: ${{ steps.round.outputs.from }}
          ROUND: ${{ steps.round.outputs.round }}
        run: |
          {
            echo 'text<<PROMPT_END'
            echo "Round $ROUND. FROM: $FROM. HEAD: $HEAD_SHA."
            echo
            sed -e "s|{FROM}|$FROM|g" ".github/review/$KIND.md"
            echo 'PROMPT_END'
          } >> "$GITHUB_OUTPUT"
      - if: steps.round.outputs.stop == 'false'
        uses: anthropics/claude-code-action@d70510b174a1244958df0b03166a54912811f3e6 # v1.0.264
        env:
          # Strips the tokens from the environment of every command it runs.
          # Files are another matter: the action writes a token into
          # .git/config, so the reviewer may not read .git.
          CLAUDE_CODE_SUBPROCESS_ENV_SCRUB: 1
        with:
          claude_code_oauth_token: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN }}
          github_token: ${{ github.token }}
          prompt: ${{ steps.prompt.outputs.text }}
          claude_args: >-
            --model claude-opus-5-5
            --disallowedTools "Read(./.git/**)"
            --allowedTools "Read(./**),Write(./.review/summary.md),Edit(./.review/summary.md),Bash(git diff:*),Bash(git log:*),Bash(git show:*),Bash(git grep:*),Bash(git ls-files:*),mcp__github_inline_comment__create_inline_comment"
      - if: steps.round.outputs.stop == 'false'
        run: |
          if [ -s .review/summary.md ]; then
            gh pr comment "$PR" --body-file .review/summary.md
          else
            echo "The reviewer wrote no summary." >&2
            exit 1
          fi
      - name: Record the round, only after a review that ran to the end
        if: steps.round.outputs.rerun == 'false'
        env:
          ROUND: ${{ steps.round.outputs.round }}
          FROM: ${{ steps.round.outputs.from }}
          COMMENT_ID: ${{ steps.round.outputs.comment_id }}
        run: bash "$RUNNER_TEMP/round.sh" record
{%- endraw %}
