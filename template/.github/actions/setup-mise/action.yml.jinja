name: Setup mise toolchain and caches
description: >
{%- if stack == 'python' %}
  Bootstraps mise (Python, uv, lefthook, cocogitto) and primes the uv cache.
{%- elif stack == 'typescript' %}
  Bootstraps mise (bun, lefthook, cocogitto) and installs the dependencies.
{%- else %}
  Bootstraps mise (lefthook, cocogitto, jq).
{%- endif %}
  Assumes the repo has already been checked out by the caller.

runs:
  using: composite
  steps:
    - uses: jdx/mise-action@c37c93293d6b742fc901e1406b8f764f6fb19dac # v2.4.4
      with:
        install: true
        cache: true
{%- if stack == 'python' %}

    - name: Cache uv
      uses: actions/cache@0057852bfaa89a56745cba8c7296529d2fc39830 # v4.3.0
      with:
        path: ~/.cache/uv
        key: {% raw %}uv-${{ runner.os }}-${{ hashFiles('uv.lock') }}{% endraw %}
        restore-keys: |
          {% raw %}uv-${{ runner.os }}-{% endraw %}

    - name: Install dependencies
      shell: bash
      run: uv sync
{%- elif stack == 'typescript' %}

    - name: Install dependencies
      shell: bash
      run: bun install --frozen-lockfile
{%- endif %}
