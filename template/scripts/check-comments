#!/usr/bin/env python3
# Fail when a commit adds a comment to Python, TypeScript, JavaScript, C or C++
# code. Only added lines count, so old comments do not block a change.
#
#   scripts/check-comments          lines the index adds over HEAD (pre-commit)
#   scripts/check-comments REF      lines HEAD adds since its merge base with REF
#                                   (pre-push, CI); every line when REF is unknown
#
# A comment may stay when it is a license header, a directive a tool reads, a
# doc comment (/** or ///), or links the spec, issue or vendor doc it follows.
# Skip generated or vendored code with git pathspec globs in .comments-excludes.
import io
import re
import subprocess
import sys
import tokenize
from pathlib import Path

PYTHON = {".py", ".pyi"}
C_LIKE = {".ts", ".tsx", ".mts", ".cts", ".js", ".jsx", ".mjs", ".cjs",
          ".c", ".h", ".cc", ".cpp", ".cxx", ".hh", ".hpp", ".hxx"}
CPP = {".c", ".h", ".cc", ".cpp", ".cxx", ".hh", ".hpp", ".hxx"}

KEEP = re.compile(
    r"SPDX-License-Identifier|Copyright|https?://"
    r"|^(noqa|type:|ty:|pyright:|mypy:|pylint:|fmt:|isort:|ruff:|pragma\b|-\*-)"
    r"|^(biome-ignore|@ts-expect-error|eslint-|prettier-ignore|istanbul |c8 |v8 )"
    r"|^(NOLINT|clang-format |IWYU pragma|namespace\b|<reference )",
    re.IGNORECASE,
)

HELP = """\
Each comment above was added by this change. Say it with names, types and
structure instead, or turn the constraint into a type, lint rule or test.
A comment stays only when it is a license header, a tool directive, a doc
comment on a public API (/** or ///), or links the spec or issue it follows.
In Claude Code, /pstack:no-comments reviews the diff the same way."""


def git(*args):
    return subprocess.run(["git", "-c", "core.quotePath=false", *args], capture_output=True, text=True, check=True).stdout


def python_comments(text):
    found = []
    try:
        for tok in tokenize.generate_tokens(io.StringIO(text).readline):
            if tok.type == tokenize.COMMENT:
                line = tok.start[0]
                if not (line == 1 and tok.string.startswith("#!")):
                    found.append((line, line, tok.string[1:].strip()))
    except (tokenize.TokenError, SyntaxError):
        pass
    return found


def raw_string_end(text, i):
    open_paren = text.find("(", i)
    if open_paren < 0:
        return len(text)
    delim = text[i:open_paren]
    close = text.find(")" + delim + '"', open_paren)
    return len(text) if close < 0 else close + len(delim) + 2


def c_comments(text, cpp):
    found, i, line, n = [], 0, 1, len(text)
    while i < n:
        c, nxt = text[i], text[i + 1 : i + 2]
        if c == "\n":
            line += 1
            i += 1
        elif c == "/" and nxt == "/":
            end = text.find("\n", i)
            end = n if end < 0 else end
            body = text[i + 2 : end]
            if not body.startswith("/") or body.startswith("//"):
                found.append((line, line, body.strip()))
            i = end
        elif c == "/" and nxt == "*":
            end = text.find("*/", i + 2)
            end = n if end < 0 else end + 2
            body = text[i:end]
            if not (body.startswith("/**") and body != "/**/"):
                found.append((line, line + body.count("\n"), body[2:-2].strip()))
            line += body.count("\n")
            i = end
        elif cpp and c == '"' and re.search(r"(?<![\w])(u8|u|U|L)?R$", text[max(0, i - 8) : i]):
            end = raw_string_end(text, i + 1)
            line += text.count("\n", i, end)
            i = end
        elif c in "\"'`":
            run = re.search(r"\w*$", text[max(0, i - 64) : i]).group()
            if c == "'" and cpp and run[:1].isdigit():
                i += 1
                continue
            j = i + 1
            while j < n and text[j] != c:
                if text[j] == "\\":
                    j += 1
                elif text[j] == "\n" and c != "`":
                    break
                j += 1
            line += text.count("\n", i, j)
            i = j + 1
        else:
            i += 1
    return found


def added_lines(compare):
    diff = git("diff", "-U0", "-M", "--diff-filter=AMR", "--no-color", "--no-ext-diff", *compare)
    added, path = {}, None
    for row in diff.splitlines():
        if row.startswith("+++ "):
            path = row[6:] if row.startswith("+++ b/") else None
        elif row.startswith("@@") and path:
            m = re.match(r"@@ -\S+ \+(\d+)(?:,(\d+))? @@", row)
            start, count = int(m.group(1)), int(m.group(2) or 1)
            added.setdefault(path, set()).update(range(start, start + count))
    return added


def excluded(paths):
    excludes = Path(".comments-excludes")
    if not excludes.is_file() or not paths:
        return set()
    globs = [g.strip() for g in excludes.read_text().splitlines() if g.strip() and not g.startswith("#")]
    if not globs:
        return set()
    out = git("ls-files", "--", *[f":(glob){g}" for g in globs])
    return set(out.splitlines())


def main():
    compare, revision = ["--cached"], ":"
    if len(sys.argv) > 1:
        ref = sys.argv[1]
        known = subprocess.run(["git", "rev-parse", "-q", "--verify", f"{ref}^{{commit}}"],
                               capture_output=True).returncode == 0
        empty_tree = git("hash-object", "-t", "tree", "/dev/null").strip()
        compare = [f"{ref}...HEAD"] if known else [empty_tree, "HEAD"]
        revision = "HEAD:"
    added = added_lines(compare)
    skip = excluded(list(added))
    failures = []
    for path, lines in sorted(added.items()):
        suffix = Path(path).suffix.lower()
        if path in skip or suffix not in PYTHON | C_LIKE:
            continue
        text = git("show", f"{revision}{path}")
        found = python_comments(text) if suffix in PYTHON else c_comments(text, suffix in CPP)
        for first, last, body in found:
            if KEEP.search(body) or not lines.intersection(range(first, last + 1)):
                continue
            failures.append(f"{path}:{first}: {body.splitlines()[0][:100] if body else '(empty)'}")
    if failures:
        print("\n".join(failures), file=sys.stderr)
        print(HELP, file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
