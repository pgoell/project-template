commit-msg:
  commands:
    cog:
      run: mise exec -- cog verify --file {1} --ignore-merge-commits --ignore-fixup-commits

pre-commit:
  commands:
{%- if stack != 'none' %}
    lint:
      run: mise run lint
{%- endif %}
    file-size:
      run: scripts/check-file-size {staged_files}
    fan-out:
      run: scripts/check-fan-out {staged_files}
{%- if stack != 'none' %}
    comments:
      run: mise exec -- scripts/check-comments
{%- endif %}

pre-push:
  commands:
{%- if stack != 'none' %}
    test:
      run: mise run test
{%- endif %}
    check-commits:
      run: mise run check-commits
    file-size:
      run: scripts/check-file-size
    fan-out:
      run: scripts/check-fan-out --all
{%- if stack != 'none' %}
    comments:
      run: mise exec -- scripts/check-comments origin/{{ default_branch }}
{%- endif %}
